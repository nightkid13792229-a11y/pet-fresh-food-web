<view class="page">
  <view class="page-header">
    <text class="page-description">爱犬信息用于计算食谱对应的饭量和价格</text>
  </view>
  <view class="card form">
    <view class="form-item">
      <view class="label">爱犬昵称<text class="required-mark">*</text></view>
      <input placeholder="请输入爱犬昵称" value="{{form.name}}" data-field="name" bindinput="handleInput" />
    </view>

    <view class="form-item">
      <view class="label">品种<text class="required-mark">*</text></view>
      <picker wx:if="{{!showOtherBreedInput}}" range="{{breedOptions}}" value="{{breedIndex}}" bindchange="handleBreedChange">
        <view class="picker-value">
          {{breedIndex >= 0 ? breedOptions[breedIndex] : '请选择品种'}}
        </view>
      </picker>
      <input wx:if="{{showOtherBreedInput}}" class="other-breed-input" placeholder="请输入品种名称" value="{{form.breed}}" data-field="breed" bindinput="handleInput" />
      <view wx:if="{{showOtherBreedInput}}" class="form-hint">当前品种：{{form.breed || '未填写'}}</view>
    </view>

    <view class="form-item">
      <view class="label">生日<text class="required-mark">*</text><text class="label-hint">（年月必选，日可选）</text></view>
      <picker mode="date" value="{{form.birthdate}}" bindchange="handleDateChange">
        <view class="picker-value">{{form.birthdate || '请选择生日'}}</view>
      </picker>
    </view>

    <view class="form-item">
      <view class="label">体重 (kg)<text class="required-mark">*</text></view>
      <input type="digit" placeholder="例如 8.5" value="{{form.weightKg}}" data-field="weightKg" bindinput="handleInput" />
    </view>

    <view class="form-item">
      <view class="label">性别</view>
      <picker range="{{sexOptions}}" range-key="label" value="{{sexIndex}}" bindchange="handleSexChange">
        <view class="picker-value">
          {{sexIndex >= 0 ? sexOptions[sexIndex].label : '选择性别'}}
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="label">是否绝育</view>
      <view class="neutered-options">
        <view 
          class="neutered-option {{form.neutered === true ? 'selected' : ''}}" 
          bindtap="handleNeuteredSelect"
          data-value="true"
        >
          <text class="check-icon">{{form.neutered === true ? '✓' : ''}}</text>
          <text>是</text>
        </view>
        <view 
          class="neutered-option {{form.neutered === false ? 'selected' : ''}}" 
          bindtap="handleNeuteredSelect"
          data-value="false"
        >
          <text class="check-icon">{{form.neutered === false ? '✓' : ''}}</text>
          <text>否</text>
        </view>
      </view>
    </view>

    <view class="form-item">
      <view class="label">生命阶段</view>
      <view wx:if="{{lifeStageDescription}}" class="life-stage-description">
        {{lifeStageDescription}}
      </view>
      <view wx:else class="life-stage-description muted">
        请填写爱犬昵称、品种和生日以自动匹配生命阶段
      </view>
    </view>

    <view class="form-item">
      <view class="label">活动水平<text class="required-mark">*</text></view>
      <view class="activity-cards">
        <view 
          wx:for="{{activityOptions}}" 
          wx:key="value"
          class="activity-card {{activityIndex === index ? 'selected' : ''}}"
          bindtap="handleActivitySelect"
          data-index="{{index}}"
        >
          <view class="activity-card-title">{{item.label}}</view>
          <view class="activity-card-desc">{{item.description}}</view>
        </view>
      </view>
    </view>

    <view class="form-item">
      <view class="label">运动-能量系数</view>
      <view class="energy-multiplier-display">
        <text wx:if="{{form.energyMultiplier && form.energyMultiplier !== '' && form.energyMultiplier !== 0 && form.energyMultiplier !== null && form.energyMultiplier !== undefined}}">{{form.energyMultiplier}}</text>
        <text wx:else>-</text>
      </view>
    </view>

    <view class="form-item">
      <view class="label">每日能量估算 (kcal)</view>
      <input type="number" placeholder="自动计算，可手动调整" value="{{form.dailyEnergyKcal}}" data-field="dailyEnergyKcal" bindinput="handleInput" />
    </view>

    <view class="form-item">
      <view class="label">平均每日零食量</view>
      <picker range="{{snackCalorieOptions}}" range-key="label" value="{{snackCalorieIndex}}" bindchange="handleSnackCalorieChange">
        <view class="picker-value">
          {{snackCalorieIndex >= 0 ? snackCalorieOptions[snackCalorieIndex].label : '请选择'}}
        </view>
      </picker>
      <view class="form-hint">选填，用于制作鲜食时预留出零食热量</view>
    </view>

    <view class="form-item">
      <view class="label">体况评分 (1-9)<text class="required-mark">*</text></view>
      <picker range="{{bodyConditionScoreOptions}}" value="{{bodyConditionScoreIndex}}" bindchange="handleBodyConditionScoreChange">
        <view class="picker-value">
          {{bodyConditionScoreIndex >= 0 ? bodyConditionScoreOptions[bodyConditionScoreIndex] : '请选择'}}
        </view>
      </picker>
      <button class="bcs-view-button" bindtap="showBCSChart">查看体况评分表</button>
      <image 
        class="bcs-preview-image" 
        src="/images/bcs-chart.png" 
        mode="aspectFit"
        bindtap="previewBCSImage"
        style="display:none;"
      />
    </view>

    <view class="form-item">
      <view class="label">每日进餐数<text class="required-mark">*</text></view>
      <picker range="{{mealsPerDayOptions}}" value="{{mealsPerDayIndex}}" bindchange="handleMealsPerDayChange">
        <view class="picker-value">
          {{mealsPerDayIndex >= 0 ? mealsPerDayOptions[mealsPerDayIndex] : '请选择'}}
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="label">过敏食物</view>
      <textarea placeholder="如：鸡肉、乳制品" value="{{form.allergyNote}}" data-field="allergyNote" bindinput="handleInput" />
    </view>

    <view class="form-item">
      <view class="label">挑食食物</view>
      <textarea placeholder="如：不喜欢吃胡萝卜" value="{{form.dietaryNote}}" data-field="dietaryNote" bindinput="handleInput" />
    </view>

    <view class="form-item">
      <view class="label">症状/疾病史</view>
      <textarea placeholder="如：轻微食物过敏" value="{{form.symptomNote}}" data-field="symptomNote" bindinput="handleInput" />
    </view>

    <view class="form-item">
      <view class="label">备注</view>
      <textarea placeholder="其他备注内容" value="{{form.notes}}" data-field="notes" bindinput="handleInput" />
    </view>

    <button class="button-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitForm">
      保存
    </button>
  </view>
</view>

