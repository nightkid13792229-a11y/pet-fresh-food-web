.page {
  padding: 24rpx;
}

.page-header {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background-color: #ecfdf5;
  border-left: 4rpx solid #10b981;
  border-radius: 8rpx;
}

.page-description {
  font-size: 26rpx;
  color: #059669;
  line-height: 1.6;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-item.inline {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.label {
  font-weight: 600;
  color: #111827;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.required-mark {
  color: #ef4444;
  font-size: 28rpx;
  margin-left: 4rpx;
}

.label-hint {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: normal;
  margin-left: 8rpx;
}

input,
textarea {
  padding: 20rpx;
  border: 1px solid #d1d5db;
  border-radius: 12rpx;
  background-color: #f9fafb;
  box-sizing: border-box;
  width: 100%;
  min-height: 80rpx;
  line-height: 1.5;
  font-size: 28rpx;
}

.picker-value {
  padding: 20rpx;
  border: 1px solid #d1d5db;
  border-radius: 12rpx;
  background-color: #f9fafb;
  box-sizing: border-box;
  width: 100%;
  min-height: 80rpx;
  line-height: 1.5;
  font-size: 28rpx;
  display: flex;
  align-items: center;
}

.other-breed-input {
  margin-top: 12rpx;
  box-sizing: border-box;
  width: 100%;
}

textarea {
  min-height: 140rpx;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
}

.neutered-options {
  display: flex;
  gap: 24rpx;
}

.neutered-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx;
  border: 2px solid #d1d5db;
  border-radius: 12rpx;
  background-color: #f9fafb;
  transition: all 0.2s;
}

.neutered-option.selected {
  border-color: #10B981;
  background-color: #ecfdf5;
  color: #10B981;
}

.check-icon {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #10B981;
}

.life-stage-description {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
  padding: 16rpx;
  background-color: #f9fafb;
  border-radius: 8rpx;
}

.life-stage-description.muted {
  color: #9ca3af;
  font-size: 24rpx;
}

.activity-cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 12rpx;
}

.activity-card {
  padding: 24rpx;
  border: 2px solid #e5e7eb;
  border-radius: 12rpx;
  background-color: #fff;
  transition: all 0.2s;
}

.activity-card.selected {
  border-color: #10b981;
  background-color: #ecfdf5;
}

.activity-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 8rpx;
}

.activity-card.selected .activity-card-title {
  color: #10b981;
}

.activity-card-desc {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}

.activity-card.selected .activity-card-desc {
  color: #059669;
}

.energy-multiplier-display {
  margin-top: 8rpx;
  padding: 20rpx;
  min-height: 80rpx;
  font-size: 30rpx;
  color: #111827;
  background-color: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.form-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.5;
}

.bcs-view-button {
  margin-top: 12rpx;
  width: 100%;
  background-color: #f9fafb;
  color: #10b981;
  border: 1px solid #10b981;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.bcs-view-button::after {
  border: none;
}

